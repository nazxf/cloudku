# ============================================
# CloudKu MySQL Shared Hosting Configuration
# ============================================
# Copy this file to .env.mysql and fill in your values
# DO NOT commit .env.mysql to version control!

# ============================================
# MySQL Root Password (CRITICAL SECURITY!)
# ============================================
# This is the master password for MySQL root user
# MUST be strong: minimum 16 characters, mix of letters, numbers, symbols
# Example: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=ChangeThisToAVerySecurePassword123!@#

# ============================================
# MySQL Connection Settings
# ============================================
# Used by CloudKu Go backend to connect to MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=ChangeThisToAVerySecurePassword123!@#

# ============================================
# phpMyAdmin Settings
# ============================================
# Port to access phpMyAdmin web interface
# Default: http://localhost:8080
PHPMYADMIN_PORT=8080

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. MYSQL_ROOT_PASSWORD and MYSQL_ADMIN_PASSWORD should be IDENTICAL
# 2. Generate secure passwords using: openssl rand -base64 32
# 3. Never use default/weak passwords in production
# 4. Keep this file secure - add .env.mysql to .gitignore
# 5. For production, consider using Docker secrets instead of .env
